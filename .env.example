# Football Data API (football-data.org)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# The Odds API (the-odds-api.com)
ODDS_API_KEY=your_odds_api_key_here

# Security
# If left unset, a random key is generated at every start (tokens reset on restart).
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Database
DATABASE_URL=sqlite:///./fairplay.db

# Comma-separated browser origins allowed by CORS.
# Defaults to http://localhost:8000, http://127.0.0.1:8000 and null (a file:// page).
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
